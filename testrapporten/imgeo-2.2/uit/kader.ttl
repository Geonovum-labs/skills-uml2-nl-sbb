imgeo:Vegetatieobject a skos:Concept ;
    dct:source bron:CityGML-1.0 ;
    isothes:broaderGeneric imgeo:IMGeoObject ;
    skos:broader imgeo:IMGeoObject ;
    skos:definition "Solitair vegetatieobject of lijn- of vlakvormige groep gelijksoortige vegetatieobjecten met een beperkte omvang."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "SolitaryVegetationObject" ;
    skos:prefLabel "vegetatieobject"@nl ;
    skos:related imgeo:NietBGTObject,
        imgeo:PlusTypeVegetatieobject ;
    skos:scopeNote "Individuele bomen hoeven alleen te worden opgenomen indien dit gewenst is. Vaak zal dit in het stedelijk gebied wel gebeuren en in landelijk gebied niet, uitzonderingen daargelaten."@nl .

imgeo:Bodembedekkers a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    isothes:broaderGeneric imgeo:Groenvoorziening ;
    skos:broader imgeo:Groenvoorziening ;
    skos:definition "Beheerde beplanting van groenvak in de openbare ruimte, zijnde bodembedekkers."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bodembedekkers"@nl ;
    skos:related imgeo:PlusFysiekVoorkomenOndersteunendWegdeel .

imgeo:Bosplantsoen a skos:Concept ;
    dct:source bron:CROW ;
    isothes:broaderGeneric imgeo:Groenvoorziening ;
    skos:broader imgeo:Groenvoorziening ;
    skos:definition "Opgaande beplanting van houtachtige gewassen die struikvormend en/of boomvormend zijn. De soorten zijn als bosplantsoen opgekweekt en aangeplant.De beplanting kan open of gesloten zijn en bestaat vaak uit inheemse soorten. Onderscheidt zich van heesters omdat de sierkenmerken niet voorop staan."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bosplantsoen"@nl ;
    skos:related imgeo:PlusFysiekVoorkomenOndersteunendWegdeel .

imgeo:Calamiteitendoorsteek a skos:Concept ;
    dct:source bron:IMGeo ;
    isothes:broaderGeneric imgeo:RijbaanAutosnelweg,
        imgeo:RijbaanAutoweg ;
    skos:broader imgeo:RijbaanAutosnelweg,
        imgeo:RijbaanAutoweg ;
    skos:definition "Een (Calamiteiten doorsteek) CADO heeft tot doel het verkeer op een rijbaan via een doorsteek van de weg te kunnen geleiden in geval van een calamiteit of werkzaamheden op de rijbaan. Een tweede doel is het faciliteren van toegang tot rijbanen voor hulpdiensten vanaf andere rijbanen of van een parallelweg."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "calamiteitendoorsteek"@nl .

imgeo:Duin a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    isothes:narrowerGeneric imgeo:GeslotenDuinvegetatie,
        imgeo:OpenDuinvegetatie ;
    skos:definition "Verhoging of heuvel van zand of fijne losse aarde en verpulverd gesteente opgeworpen door wind of door stromend water."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower imgeo:GeslotenDuinvegetatie,
        imgeo:OpenDuinvegetatie ;
    skos:prefLabel "duin"@nl .

imgeo:FunctioneelGebied a skos:Concept ;
    dct:source bron:BRT-stelselcatalogus ;
    isothes:broaderGeneric imgeo:IMGeoObject ;
    skos:broader imgeo:IMGeoObject ;
    skos:closeMatch nen3610:FunctioneelGebied ;
    skos:definition "Begrensd en benoemd gebied dat door een functionele eenheid beschreven wordt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "FunctioneelGebied" ;
    skos:prefLabel "functioneel gebied"@nl ;
    skos:related imgeo:NaamFunctioneelGebied,
        imgeo:PlusTypeFunctioneelGebied,
        imgeo:TypeFunctioneelGebied .

imgeo:GrasEnKruidachtigen a skos:Concept ;
    dct:source bron:CROW ;
    isothes:broaderGeneric imgeo:Groenvoorziening ;
    skos:broader imgeo:Groenvoorziening ;
    skos:definition "(Grond met) een laagblijvende, aaneengesloten kruidachtige vegetatie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "gras- en kruidachtigen"@nl ;
    skos:related imgeo:PlusFysiekVoorkomenOndersteunendWegdeel .

imgeo:Heesters a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    isothes:broaderGeneric imgeo:Groenvoorziening ;
    skos:broader imgeo:Groenvoorziening ;
    skos:definition "Beplanting van houtige gewassen die struikvormend zijn en die al dan niet een gesloten geheel vormen. Het accent ligt op de sierwaarde, de beplanting kan uit één soort of uit meerdere soorten bestaan. Onder de heesters kan een houtachtige of kruidachtige onderbegroeiing aanwezig zijn. Het oppervlak met struikachtige gewassen is meer dan 50% van de totale oppervlakte van het vak."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "heesters"@nl ;
    skos:related imgeo:PlusFysiekVoorkomenOndersteunendWegdeel .

imgeo:OnbegroeidTerreindeel a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    isothes:broaderGeneric imgeo:IMGeoObject ;
    skos:broadMatch nen3610:Terrein ;
    skos:broader imgeo:IMGeoObject ;
    skos:definition "Kleinste functioneel onafhankelijk stukje van een terrein, dat er binnen het objecttype Terrein van NEN 3610 wordt onderscheiden, zonder aaneengesloten vegetatie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OnbegroeidTerreindeel" ;
    skos:prefLabel "onbegroeid terreindeel"@nl ;
    skos:related imgeo:FysiekVoorkomenOnbegroeidTerreindeel,
        imgeo:OnbegroeidTerreindeelOpTalud,
        imgeo:PlusFysiekVoorkomenOnbegroeidTerreindeel .

imgeo:OnverhardTerreindeel a skos:Concept ;
    dct:source bron:IMGeo-1.0 ;
    isothes:narrowerGeneric imgeo:Boomschors,
        imgeo:ZandDeklaag ;
    skos:altLabel "onverhard"@nl ;
    skos:definition "Terreindeel waar geen verharding of aaneengesloten vegetatie aanwezig is, niet zijnde zand. Braakliggend valt hier wel onder."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower imgeo:Boomschors,
        imgeo:ZandDeklaag ;
    skos:prefLabel "onverhard terreindeel"@nl .

imgeo:OpenbareRuimteLabel a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    isothes:broaderGeneric imgeo:IMGeoObject ;
    skos:broader imgeo:IMGeoObject ;
    skos:definition "Naam en plaatsingspunten van een in de BAG geregistreerde OPENBARE RUIMTE."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
