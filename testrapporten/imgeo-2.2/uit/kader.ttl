    isothes:broaderGeneric imgeo:OverigeConstructie ;
    skos:broader imgeo:OverigeConstructie ;
    skos:definition "Met de aarde verbonden duurzaam bouwwerk, dat niet valt onder de definities van een pand of kunstwerk."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OverigBouwwerk" ;
    skos:prefLabel "overig bouwwerk"@nl ;
    skos:related imgeo:PlusTypeOverigBouwwerk,
        imgeo:TypeOverigBouwwerk ;
    skos:scopeNote "Een Overig Bouwwerk heeft in de BGT altijd vlakgeometrie. Een overkapping heeft multivlakgeometrie."@nl .

imgeo:Pand a skos:Concept ;
    dct:source bron:Stelselcatalogus ;
    isothes:broaderGeneric imgeo:IMGeoObject ;
    skos:broadMatch nen3610:Gebouw ;
    skos:broader imgeo:IMGeoObject ;
    skos:definition "Een PAND is de kleinste bij de totstandkoming functioneel en bouwkundig-constructief zelfstandige eenheid die direct en duurzaam met de aarde is verbonden en betreedbaar en afsluitbaar is."@nl ;
    skos:exactMatch bag:Pand ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "BuildingPart" ;
    skos:prefLabel "pand"@nl ;
