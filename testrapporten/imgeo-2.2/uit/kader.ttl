imgeo:Inrichtingselement a skos:Concept ;
    dct:source bron:NEN3610-2011 ;
    isothes:broaderGeneric imgeo:IMGeoObject ;
    isothes:narrowerGeneric imgeo:Bak,
        imgeo:Bord,
        imgeo:Installatie,
        imgeo:Kast,
