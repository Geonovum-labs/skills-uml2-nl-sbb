    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Scheiding" ;
    skos:prefLabel "scheiding"@nl ;
    skos:related imgeo:PlusTypeScheiding,
        imgeo:TypeScheiding .

imgeo:Sensor a skos:Concept ;
