bron:NEN2660 rdfs:label "NEN 2660 Ordeningsregels gebouwde omgeving"@nl ;
    dct:bibliographicCitation "NEN 2660 Ordeningsregels gebouwde omgeving"^^xsd:string ;
    dct:title "NEN 2660 Ordeningsregels gebouwde omgeving"@nl .

bron:Wegenwiki rdfs:label "Wegenwiki (wegenwiki.nl)"@nl ;
    dct:bibliographicCitation "Wegenwiki (wegenwiki.nl)"^^xsd:string ;
    dct:title "Wegenwiki (wegenwiki.nl)"@nl .

imgeo:Abri a skos:Concept ;
    dct:source bron:IMGeo-1.0 ;
