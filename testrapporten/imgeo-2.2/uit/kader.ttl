    skos:prefLabel "cementbeton"@nl ;
    skos:related imgeo:PlusFysiekVoorkomenOndersteunendWegdeel .

imgeo:GebakkenKlinkers a skos:Concept ;
    dct:source bron:CROW ;
    isothes:broaderGeneric imgeo:OpenVerharding ;
    skos:broader imgeo:OpenVerharding ;
