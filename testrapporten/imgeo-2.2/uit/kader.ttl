    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower imgeo:Verbindingsweg,
        imgeo:Verkeersdrempel ;
    skos:prefLabel "rijbaan regionale weg"@nl .

imgeo:Struikrozen a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    isothes:broaderGeneric imgeo:Groenvoorziening ;
    skos:broader imgeo:Groenvoorziening ;
    skos:definition "Beheerde beplanting van groenvak in de openbare ruimte, zijnde in struikvorm groeiende rozen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "struikrozen"@nl ;
    skos:related imgeo:PlusFysiekVoorkomenOndersteunendWegdeel .

imgeo:Verkeersdrempel a skos:Concept ;
    dct:source bron:NEN2660 ;
    isothes:broaderGeneric imgeo:RijbaanLokaleWeg,
        imgeo:RijbaanRegionaleWeg ;
