        imgeo:Paal,
        imgeo:Put,
        imgeo:Sensor,
        imgeo:Straatmeubilair,
        imgeo:Waterinrichtingselement,
        imgeo:Weginrichtingselement ;
    skos:broader imgeo:IMGeoObject ;
    skos:closeMatch nen3610:Inrichtingselement ;
    skos:definition "Een ruimtelijk object al dan niet ter detaillering dan wel ter inrichting van de overige benoemde ruimtelijke objecten of een ander inrichtingselement."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower imgeo:Bak,
        imgeo:Bord,
        imgeo:Installatie,
        imgeo:Kast,
        imgeo:Mast,
        imgeo:Paal,
        imgeo:Put,
        imgeo:Sensor,
        imgeo:Straatmeubilair,
        imgeo:Waterinrichtingselement,
        imgeo:Weginrichtingselement ;
    skos:notation "CityFurniture" ;
    skos:prefLabel "inrichtingselement"@nl ;
    skos:scopeNote "Inrichtingselementen vormen een diverse klasse. Het zijn objecten die niet zozeer op basis van fysiek voorkomen of hun gebruiksfunctie bij elkaar horen, maar op basis van hun eigenschap dat ze andere objecten inrichten. Het zijn objecten die een relatief kleine geometrie hebben. Voorbeelden zijn: stadsbankje, reclamebord, verkeerslicht, verkeersheuvel, fontein, grondwaterput."@nl .

