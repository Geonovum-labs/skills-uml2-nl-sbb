    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "fietsenkluis"@nl ;
    skos:related imgeo:PlusTypeStraatmeubilair .

imgeo:Fietsenrek a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
