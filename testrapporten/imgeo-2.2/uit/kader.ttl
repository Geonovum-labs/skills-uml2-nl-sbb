    skos:definition "Wegdeel uitsluitend bedoeld voor vliegverkeer."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "baan voor vliegverkeer"@nl .

imgeo:Balustrade a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    skos:definition "Een balustrade is een hekwerk of afzetting aan de rand van een overbrugging. Een balustrade beveiligt tegen het vallen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "balustrade"@nl .

imgeo:BegroeidTerreindeelOpTalud a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "begroeidTerreindeelOpTalud"@nl ;
    skos:definition "Indicatie of het object wel of niet op een hellend vlak ligt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "PlantCover.begroeidTerreindeelOpTalud" ;
    skos:prefLabel "begroeid terreindeel op talud"@nl ;
    skos:related imgeo:BegroeidTerreindeel .

imgeo:Bestaand a skos:Concept ;
    dct:source bron:IMGeo-1.0 ;
    skos:definition "Situatie waarin het object wordt / kan worden gebruikt voor het doel waarvoor het is gebouwd / aangelegd."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bestaand"@nl .

imgeo:Betonning a skos:Concept ;
    dct:source bron:Aquo ;
    skos:definition "Een systeem van boeien en bakens, waarmee in open zee of in een vaarwater ondiepten of de aanwezigheid van gevaarlijke objecten worden aangegeven."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "betonning"@nl .

imgeo:Bodemval a skos:Concept ;
    dct:source bron:Aquo ;
    skos:definition "Sprong in de bodem van een waterloop."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bodemval"@nl .

imgeo:Boomspiegel a skos:Concept ;
    dct:source bron:Wikipedia ;
    skos:definition "Het stuk grond rondom de stam van een boom dat van boven toegankelijk is voor lucht en water."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "boomspiegel"@nl ;
    skos:scopeNote "De boomspiegel wordt als puntobject opgenomen en geeft de plaats aan waar de boomspiegel zich bevindt. Het preciese oppervlak van de boomspiegel wordt niet opgenomen."@nl .

imgeo:Boomteelt a skos:Concept ;
    dct:source bron:CROW ;
    skos:definition "Grond in gebruik voor het kweken van jonge siergewassen, bomen enz. ten behoeve van een later gebruik elders."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "boomteelt"@nl .

imgeo:Bronhouder a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "De bronhoudercode van het object."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "_CityObject.bronhouder" ;
    skos:prefLabel "bronhouder"@nl ;
    skos:related imgeo:IMGeoObject ;
    skos:scopeNote "Per object (dus niet per objecttype) moet de bronhouder worden vastgelegd zodat hiernaar kan worden gerefereerd bij terugmeldingen. Een object valt altijd geheel binnen het gebied van één bronhouder."@nl .

imgeo:Brug a skos:Concept ;
    dct:source bron:CROW ;
    skos:definition "Kunstwerk over een watervlakte of waterloop, bestaande uit een brugdek gesteund door pijlers en/of landhoofden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "brug"@nl .

imgeo:Buurtcode a skos:Concept ;
    dct:source bron:RSGB ;
    skos:definition "De code behorende bij de naam van de buurt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Buurt.buurtcode" ;
    skos:prefLabel "buurtcode"@nl ;
    skos:related imgeo:Buurt ;
    skos:scopeNote "De CBS buurtcode."@nl .

imgeo:Coupure a skos:Concept ;
    dct:source bron:Aquo ;
    skos:definition "Een onderbreking in een waterkering voor de doorvoer van een weg of spoorweg, die bij extreme waterstanden afsluitbaar is."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "coupure"@nl .

imgeo:DatumInwinning a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "datumInwinning"@nl ;
    skos:definition "Datum waarop het punt is ingewonnen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Plaatsbepalingspunt.datumInwinning" ;
    skos:prefLabel "datum inwinning"@nl ;
    skos:related imgeo:Plaatsbepalingspunt ;
    skos:scopeNote "Als de inwinningsdatum van het punt tijdens transitie onbekend is, moet hier de datum van de transitie (gelijk aan objectBeginTijd) worden ingevuld."@nl .

imgeo:Duiker a skos:Concept ;
    dct:source bron:CROW ;
    skos:definition "Kunstwerk voor de waterhuishouding, bestaande uit een gesloten kokervormige constructie met een in- en uitstroomopening, niet de gehele waterbreedte beslaand en aangebracht onder een weg of spoorweg of in een dam. (bron: CROW)"@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "duiker"@nl .

imgeo:Ecoduct a skos:Concept ;
    dct:source bron:CROW ;
    skos:definition "Wildwissel in de vorm van een viaduct voor passages van dieren over een weg of spoorweg."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "ecoduct"@nl .

imgeo:EindRegistratie a skos:Concept ;
    dct:source bron:NEN3610-2011 ;
    skos:altLabel "eindRegistratie"@nl ;
    skos:closeMatch nen3610:EindRegistratie ;
    skos:definition "Eind van de periode waarop deze instantie van het object geldig is bij de bronhouder. Wanneer deze waarde niet is ingevuld is de instantie nog geldig."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "_CityObject.eindRegistratie" ;
    skos:prefLabel "eind registratie"@nl ;
    skos:related imgeo:IMGeoObject .

imgeo:Erf a skos:Concept ;
    dct:source bron:IMGeo-1.0 ;
    skos:definition "Terreindeel dat bij een pand of overig bouwwerk hoort, dat niet nader wordt ingewonnen en dat bestaat uit een mengvorm van begroeiing, verharding, en/of water."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "erf"@nl ;
    skos:scopeNote "'Erf' wordt gebruikt als een verzamelterm voor terreinen die ondersteunend zijn aan panden en die niet verder onderscheidend worden ingewonnen. Hoewel 'erf' onder OnbegroeidTerreindeel is ingedeeld, mogen erven die (deels) begroeid zijn, toch als 'erf' worden geclassificeerd. Erven rondom boerderijen en op industrieterreinen zijn vaak grotendeels onbegroeid. Bovendien is Erf als OnbegroeidTerrein geclassificeerd omdat dit beter aansluit bij de op kleinschaliger niveau gehanteerde naamgeving ‘bebouwd terrein’."@nl .

imgeo:Faunavoorziening a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    skos:definition "Voorziening bij een weg of spoorweg, niet zijnde een ecoduct, om de uit dat werk voortvloeiende negatieve gevolgen voor de fauna zoveel mogelijk te voorkomen of te beperken."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "faunavoorziening"@nl .

imgeo:Fietspad a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Wegdeel met name bestemd voor fietsers en, indien toegestaan, bromfietsers en dat afgescheiden is van de andere wegdelen niet uitsluitend door markering."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "fietspad"@nl .

imgeo:FlyOver a skos:Concept ;
    dct:source bron:CROW ;
    skos:definition "Kunstwerk in de vorm van een viaduct dat deel uitmaakt van een verkeersbaan en waarmee een verkeersstroom over twee of meer ongelijkvloerse verkeersstromen wordt geleid."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "fly-over"@nl .

imgeo:Fotogrammetisch a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "De geometrie is ingewonnen vanaf daartoe geschikte (digitale) foto's, meestal luchtfoto's."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "fotogrammetisch"@nl .

imgeo:FysiekVoorkomenOnbegroeidTerreindeel a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "bgt-fysiekVoorkomen"@nl ;
    skos:definition "Classificatie van het soort terrein, ingedeeld naar de uiterlijke verschijningsvorm."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OnbegroeidTerreindeel.bgt-fysiekVoorkomen" ;
    skos:prefLabel "fysiek voorkomen onbegroeid terreindeel"@nl ;
    skos:related imgeo:OnbegroeidTerreindeel .

imgeo:GeenWaarde a skos:Concept ;
    dct:source bron:NEN3610-2011 ;
    skos:altLabel "geenWaarde"@nl ;
    skos:closeMatch nen3610:GeenWaarde ;
    skos:definition "Element heeft in werkelijkheid geen waarde."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "geen waarde"@nl .

imgeo:Geleideconstructie a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    skos:definition "Bermbeveiligingsconstructie bedoeld voor fysieke geleiding van voertuigen die uit de koers zijn geraakt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "geleideconstructie"@nl .

imgeo:Geleidewerk a skos:Concept ;
    dct:source bron:Aquo ;
    skos:definition "Fuikvormige constructie aansluitend aan het hoofd van een kunstwerk voor het geven van mechanische en visuele geleiding tijdens het invaren van dat kunstwerk."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "geleidewerk"@nl .

imgeo:Gemaal a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Een kunstwerk in principe bedoeld om water van een laag peil naar een hoog peil te brengen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "gemaal"@nl .

imgeo:GemengdBos a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Terreindeel begroeid met een dusdanige aantal naald- en loofbomen dat deze een min of meer gesloten geheel vormen of, na volgroeiing van de bomen, zullen vormen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "gemengd bos"@nl .

imgeo:GraslandAgrarisch a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Terreindeel met een vegetatie bestaande uit grassen en of grasachtigen, en met de in graslanden voorkomende kruiden, zijnde cultuurgrasland dat in gebruik is voor de veeteelt, bijvoorbeeld als weiland of als hooiland."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "grasland agrarisch"@nl .

imgeo:GraslandOverig a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Terreindeel met een vegetatie bestaande uit grassen en of grasachtigen, en met de in graslanden voorkomende kruiden, dat niet in gebruik is voor agrarische doeleinden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "grasland overig"@nl .

imgeo:GreppelDrogeSloot a skos:Concept ;
    dct:source bron:IMGeo-1.0 ;
    skos:definition "Een ten behoeve van de waterbeheersing gegraven geul die al dan niet met water bedekt is."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "greppel, droge sloot"@nl .

imgeo:Hectometeraanduiding a skos:Concept ;
    skos:definition "Code van de paal die kan worden gebruikt voor afstandsaanduiding, zoals bij hectometerpaaltjes en dijkpalen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Paal.hectometeraanduiding" ;
    skos:prefLabel "hectometeraanduiding"@nl ;
    skos:related imgeo:Paal .

imgeo:Heide a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Terreindeel overwegend begroeid met heide en heideachtige vegetaties."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "heide"@nl .

imgeo:HoekLabelpositie a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "hoek"@nl ;
    skos:definition "De rotatie van het label bij visualisatie, met de klok mee ten opzichte van de normale tekstrichting."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Labelpositie.hoek" ;
    skos:prefLabel "hoek labelpositie"@nl ;
    skos:related imgeo:Labelpositie .

imgeo:Hoogspanningsmast a skos:Concept ;
    dct:source bron:IMGeo-1.0 ;
    skos:definition "Metalen mast of stellage ter ondersteuning van geleidedraden voor het transport van elektriciteit met een hoog voltage."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "hoogspanningsmast"@nl .

imgeo:Hoogtemerk a skos:Concept ;
    dct:source bron:Aquo ;
    skos:definition "Relatief permanent merk, natuurlijk of kunstmatig, met daarin een punt met een bekende hoogte ten opzichte van een bepaald referentievlak."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "hoogtemerk"@nl .

imgeo:HoortBijTypeOverbrugging a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    skos:altLabel "hoortBijTypeOverbrugging"@nl ;
    skos:definition "Nadere classificatie van de overbrugging waar het overbruggingsdeel een onderdeel van is."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "BridgeConstructionElement.hoortBijTypeOverbrugging" ;
    skos:prefLabel "hoort bij type overbrugging"@nl ;
    skos:related imgeo:Overbruggingsdeel .

imgeo:Houtwal a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Terreindeel zijnde een afscheiding met beperkte breedte en beplant met bomen of struiken."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "houtwal"@nl .

imgeo:IdentificatieBAGOPR a skos:Concept ;
    dct:source bron:BAG-catalogus ;
    skos:altLabel "identificatieBAGOPR"@nl ;
    skos:definition "De unieke identificatie van het object zoals is toegekend in de BAG-administratie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OpenbareRuimteLabel.identificatieBAGOPR" ;
    skos:prefLabel "identificatie BAGOPR"@nl ;
    skos:related imgeo:OpenbareRuimteLabel .

imgeo:IdentificatieBAGPND a skos:Concept ;
    dct:source bron:BAG-catalogus ;
    skos:altLabel "identificatieBAGPND"@nl ;
    skos:definition "De unieke identificatie van het object zoals is toegekend in de BAG-administratie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "BuildingPart.identificatieBAGPND" ;
    skos:prefLabel "identificatie BAGPND"@nl ;
    skos:related imgeo:Pand .

imgeo:IdentificatieBAGVBOHoogsteHuisnummer a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "identificatieBAGVBOHoogsteHuisnummer"@nl ;
    skos:definition "Identificatie in de BAG registratie van het verblijfsobject met het hoogste huisnummer behorende tot de reeks."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Nummeraanduidingreeks.identificatieBAGVBOHoogsteHuisnummer" ;
    skos:prefLabel "identificatie BAGVBO hoogste huisnummer"@nl ;
    skos:related imgeo:Nummeraanduidingreeks .

imgeo:IdentificatieBAGVBOLaagsteHuisnummer a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "identificatieBAGVBOLaagsteHuisnummer"@nl ;
    skos:definition "Identificatie in de BAG registratie van het verblijfsobject met het laagste huisnummer behorende tot de reeks."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Nummeraanduidingreeks.identificatieBAGVBOLaagsteHuisnummer" ;
    skos:prefLabel "identificatie BAGVBO laagste huisnummer"@nl ;
    skos:related imgeo:Nummeraanduidingreeks .

imgeo:InOnderzoek a skos:Concept ;
    dct:source bron:Stelselcatalogus ;
    skos:altLabel "inOnderzoek"@nl ;
    skos:definition "Een aanduiding waarmee wordt aangegeven dat een onderzoek wordt uitgevoerd naar de juistheid van een of meer gegevens van het betreffende object."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "_CityObject.inOnderzoek" ;
    skos:prefLabel "in onderzoek"@nl ;
    skos:related imgeo:IMGeoObject .

imgeo:Inrit a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    skos:definition "Toegangswegen, oprijlanen en dergelijke met verkeersfunctie die leiden naar erven en terreinen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "inrit"@nl .

imgeo:InwinnendeInstantie a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "inwinnendeInstantie"@nl ;
    skos:definition "De organisatie die namens de bronhouder het object inwint."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Plaatsbepalingspunt.inwinnendeInstantie" ;
    skos:prefLabel "inwinnende instantie"@nl ;
    skos:related imgeo:Plaatsbepalingspunt ;
    skos:scopeNote "De inwinnende instantie kan de bronhouder zelf zijn of een organisatie aan wie dit is gedelegeerd. De Codelist is dezelfde lijst als die van de bronhouder van het BGTObject, maar dan uitgebreid met de inwinnende instanties. Indien de inwinnende instantie voor haar uitvoerende taak gebruik maakt van externe organisaties (zoals landmeetkundige bureaus) dan worden deze laatsten NIET aan de CodeList toegevoegd maar vullen zij de inwinnende instantie in voor wie zij het werk uitvoeren."@nl .

imgeo:Inwinningsmethode a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "De wijze waarop het punt is ingewonnen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Plaatsbepalingspunt.inwinningsmethode" ;
    skos:prefLabel "inwinningsmethode"@nl ;
    skos:related imgeo:Plaatsbepalingspunt .

imgeo:Keermuur a skos:Concept ;
    dct:source bron:Wikipedia ;
    skos:definition "Een keermuur of keerwand is een stijf, grond- of waterkerend kunstwerk dat door een groot gewicht en een brede voet een grote standzekerheid kan bereiken. Een keermuur is meestal van gewapend beton, maar er kan ook ander materiaal gebruikt worden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "keermuur"@nl .

imgeo:Kwelder a skos:Concept ;
    dct:source bron:Aquo ;
    skos:definition "Buitendijks gelegen aangeslibd land van een wad, dat bij gewone vloed niet meer onder loopt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "kwelder"@nl .

imgeo:LVPublicatiedatum a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Tijdstip waarop deze instantie van het object is opgenomen in de landelijke voorziening."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "_CityObject.LV-publicatiedatum" ;
    skos:prefLabel "LV-publicatiedatum"@nl ;
    skos:related imgeo:IMGeoObject ;
    skos:scopeNote "Het gegeven is optioneel omdat een nieuw object pas een LV-publicatiedatum krijgt als het voor de eerste keer wordt opgenomen in de landelijke voorziening. Voor en tijdens aanlevering van een nieuw object aan de landelijke voorziening ontbreekt dit gegeven nog."@nl .

imgeo:Laser a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "De geometrie is met behulp van een laserscanner ingewonnen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "laser"@nl .

imgeo:Lijnafwatering a skos:Concept ;
    dct:source bron:IMGeo-2.0 ;
    skos:definition "Goot in de lengterichting van de verharding, niet zijnde molgoot. Bijvoorbeeld roostergoot en verholen goot."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "lijnafwatering"@nl .

imgeo:LokaalID a skos:Concept ;
    dct:source bron:NEN3610-2011 ;
    skos:altLabel "lokaalID"@nl ;
    skos:definition "Unieke identificatiecode binnen een registratie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "NEN3610ID.lokaalID" ;
    skos:prefLabel "lokaal ID"@nl ;
    skos:related imgeo:NEN3610ID ;
    skos:scopeNote "LokaalID is de identificatiecode die een object heeft binnen een (lokaal) registratie. De volgende karakters mogen in een lokaalID voorkomen: {”A” …”Z”, “a”…”z”,”0”…”9”, “_”, “-“, “,”,”.”} Dit is de IMGeo identificatie. Een betekenisloos nummer."@nl .

imgeo:Meerpaal a skos:Concept ;
    dct:source bron:Aquo ;
    skos:definition "Paal voor een kade of in een haven waaraan een schip kan worden afgemeerd."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "meerpaal"@nl .

imgeo:Moeras a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:definition "Terreindeel met moerasvegetatie in stilstaand water van geringe diepte zonder merkbare toe- of afvloeiing."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "moeras"@nl .

imgeo:Molgoot a skos:Concept ;
    dct:source bron:CROW ;
    skos:definition "Smalle goot (lijngeometrie) in de lengterichting van de verharding, met veelal een cirkelsegment als dwarsprofiel."@nl ;
