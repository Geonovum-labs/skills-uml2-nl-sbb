    skos:definition "Een voorziening om de waterloop dan wel één of meerdere objecten benedenstrooms te vrijwaren van drijvend vuil en dergelijke."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "vuilvang"@nl ;
    skos:scopeNote "Drijfbalk valt hier ook onder."@nl .

imgeo:WaardeOnbekend a skos:Concept ;
    dct:source bron:NEN3610-2011 ;
    skos:altLabel "waardeOnbekend"@nl ;
    skos:closeMatch nen3610:WaardeOnbekend ;
    skos:definition "Element is verplicht maar de waarde is bij de zender niet bekend."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "waarde onbekend"@nl .

imgeo:WegdeelOpTalud a skos:Concept ;
    dct:source bron:BGT-catalogus ;
    skos:altLabel "wegdeelOpTalud"@nl ;
