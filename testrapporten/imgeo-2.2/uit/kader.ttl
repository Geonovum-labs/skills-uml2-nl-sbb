        imgeo:OpenbareRuimteNaam,
        imgeo:OpenbareRuimteType ;
    skos:scopeNote "Dit objecttype wordt in de BGT geregistreerd ten behoeve van visualisatie-doeleinden. In het optionele IMGeo deel is het mogelijk ook de vlakgeometrie van de openbare ruimte op te nemen."@nl .

imgeo:Paal a skos:Concept ;
    dct:source bron:IMGeo-1.0 ;
    isothes:broaderGeneric imgeo:Inrichtingselement ;
    skos:broader imgeo:Inrichtingselement ;
    skos:definition "Langwerpig stuk hout, ijzer, steen enz., dat in de grond staat."@nl ;
