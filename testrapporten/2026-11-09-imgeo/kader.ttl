<http://definities.geostandaarden.nl/imgeo/id/begrip/Plaatsbepalingspunt> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:definition "Punt dat is ingemeten en vervolgens gebruikt is bij en onderdeel uitmaakt van de begrenzing van BGT objecten."@nl ;
