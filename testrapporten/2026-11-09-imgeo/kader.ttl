    skos:prefLabel "draadraster"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeScheidingPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Drainageput> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Putdeksel welke toegang geeft naar een poreuze of geperforeerde buisleiding, aangebracht onder de grond om de afwatering van de grond te verbeteren."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "drainageput"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePut> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Drinkbak> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Bak gevuld met water, waaruit vee of wild kan drinken."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "drinkbak"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeBak> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Drukknoppaal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Paal met een lengte van ongeveer 1 m, met drukknop waarmee de verkeersdeelnemer zich meldt bij een verkeersregelinstallatie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "drukknoppaal"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/DynamischeSnelheidsindicator> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een snelheidsinformatiebord dat in \"real time\" de snelheid van de weggebruikers aanduidt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "dynamische snelheidsindicator"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeBord> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Elektrakast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Kast ten behoeve van de regeling van het transport van elektriciteit."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "elektrakast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeKast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Faunaraster> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Kunstmatig aangebrachte scheiding van metaaldraad tussen palen, bedoeld voor het leiden van dieren."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "faunaraster"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeScheidingPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Fietsenkluis> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Wikipedia> ;
    skos:definition "Een fietskluis is een kluis om een fiets in te bewaren, meestal ter voorkoming van diefstal of beschadiging."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "fietsenkluis"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Fietsenrek> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een duurzaam verankerd rek in de openbare ruimte voor het stallen van fietsen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "fietsenrek"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Flitser> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een flitser bevat een mechanisme om een snelheidsmeting uit te voeren om snelheidsovertredingen in het verkeer te kunnen vaststellen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "flitser"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeSensor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Fontein> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Wikipedia> ;
    skos:definition "Een fontein is een natuurlijke of kunstmatige installatie die water spuit."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "fontein"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/FunctieSpoor> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-1> ;
    skos:altLabel "plus-functieSpoor"@nl ;
    skos:definition "Specificatie van het soort gebruik van het spoor, indien dit een IMGeo uitbreiding van de populatie betreft."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Railway.plus-functieSpoor" ;
    skos:prefLabel "functie spoor"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Havenkraan>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Spoor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/FunctioneelBeheer> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Gebied waar een specifiek beheer voor benodigd is, louter bepaald vanuit beheersoogpunt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "functioneel beheer"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/GMSKast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Kast ten behoeve van het meten van weers- en wegdekomstandigheden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "GMS kast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeKast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/GMSSensor> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Gladheidsmeldsysteem (GMS) waarmee de kans op gladheid wordt voorspeld aan de hand van meting en interpretatie van de parameters die een rol spelen bij het ontstaan van gladheid."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "GMS sensor"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeSensor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Gaskast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Kast ten behoeve van de regeling van het transport van gas."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "gaskast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeKast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Gasput> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Putdeksel met afsluitkraan ten behoeve van het ondergrondse leidingenstelsel voor gastransport."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "gasput"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePut> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Geluidsscherm> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een scheiding bedoeld om geluidshinder in de buitenlucht te verminderen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "geluidsscherm"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeScheiding> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Grensmarkering> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Paal ter afbakening van een grens."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "grensmarkering"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Haag> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:definition "Een rijvormige afscheiding van zeer beperkte breedte bestaande uit aangeplante aaneengesloten struiken."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "haag"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeVegetatieobject> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Haltepaal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Paal met daarop de dienstregeling ten behoeve van het openbaar vervoer."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "haltepaal"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Havenkraan> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:altLabel "(haven)kraan"@nl ;
    skos:definition "Spoorbaan waarop een hefkraan (bij een haven) zich voortbeweegt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "havenkraan"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FunctieSpoor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Hectometerpaal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Paaltje of bordje geplaatst langs de weg, waarop een hectometerwaarde (weg) of kilometrering (vaarweg) is vermeld eventueel gevolgd door een letter."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "hectometerpaal"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Hek> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een hekwerk of schutting, typisch ten behoeve van erfafscheiding."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "hek"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeScheiding> ;
    skos:scopeNote "Een hek is meestal gemaakt van hout of metaal."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Herdenkingsmonument> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Langs de weg of elders in het terrein aangelegd object ter herdenking van personen of evenementen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "herdenkingsmonument"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> ;
    skos:scopeNote "Een herdenkingsmonument kan bijvorobeeld herinneren aan verkeersslachtoffers."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Hondenuitlaatplaats> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:altLabel "functioneel beheer: hondenuitlaatplaats"@nl ;
    skos:definition "Een uitlaatplaats waar uw hond zijn behoefte kan/ mag doen waarbij geen opruimplicht bestaat."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "hondenuitlaatplaats"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Hoogtedetectieapparaat> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een mechanisch of elektronisch waarschuwingssysteem, dat in werking treedt bij overschrijding van de aangegeven maximale doorrijhoogte."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "hoogtedetectieapparaat"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeSensor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Identificatie> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-3610-2011> ;
    skos:definition "Uniek identificatienummer voor het object dat onveranderlijk is zolang het object bestaat."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "_CityObject.identificatie" ;
    skos:prefLabel "identificatie"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Plaatsbepalingspunt> ;
    skos:scopeNote "Zie 3.10 van de gegevenscatalogus."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Informatiebord> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Een bord met daarop specifieke actuele informatie, zoals plattegronden of vertrektijden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "informatiebord"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeBord> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/InfrastructuurVerkeerEnVervoer> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:definition "Gebied primair in gebruik voor verkeer en vervoer, waaronder verstaan spoorwegen, wegdelen, vliegverkeersbanen, parkeerterreinen, bermen en de ondersteunende objecten als kunstwerken."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "infrastructuur verkeer en vervoer"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/InfrastructuurWaterstaatswerken> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:definition "Gebied grenzend aan oppervlaktewater, primair in gebruik voor de oppervlaktewaterhuishouding (waterafvoer, wateraanvoer en waterconservering)."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "infrastructuur waterstaatswerken"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/InspectieOfRioolput> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:altLabel "inspectie- / rioolput"@nl ;
    skos:definition "Putdeksel die toegang geeft tot een (riool)leiding."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "inspectie- of rioolput"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePut> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Kademuur> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Verticale wand ter scheiding van land en water, opgebouwd uit een muur van gemetselde stenen of gestort beton."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "kademuur"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeScheiding> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Kering> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/aquo> ;
    skos:definition "Een waterkerende en / of scheidende, kunstmatige of natuurlijke hoogte of hooggelegen gronden inclusief de daarin aanwezige waterkerende elementen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "kering"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebied> ;
    skos:scopeNote "Voorbeelden van waterkeringen zijn ondermeer: primaire en secundaire waterkeringen, polderkaden, boezemkaden en waterscheidingen."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Kolk> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Deksel van een op het riool aangesloten voorziening voor de opvang van hemel- en afvalwater afkomstig van erop aangesloten oppervlakken."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "kolk"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePut> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Kunstobject> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Een object dat als kunst gezien wordt en een bepaalde schoonheid heeft, niet door de natuur gemaakt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "kunstobject"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Kunstwerk> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-3610-2011> ;
    skos:definition "Civiel-technisch werk voor de infrastructuur van wegen, water, spoorbanen, waterkeringen en/of leidingen en niet bedoeld voor permanent menselijk verblijf."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "kunstwerk"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimte> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Laagspanningsmast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Houten of metalen mast waaraan kabels voor het transport van elektrische energie met een spannning lager dan 500 V zijn bevestigd."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "laagspanningsmast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeMast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/LageTrafo> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Bouwwerk waarin transformator(en) zijn geplaatst voor elektriciteitsvoorziening."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "lage trafo"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeOverigBouwwerk> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Landbouw> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:definition "Gebied primair in gebruik voor land- en tuinbouwproductie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "landbouw"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Landhoofd> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Ondersteuningsconstructie ter plaatse van een overgang van de aardebaan naar een kunstwerk."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "landhoofd"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Overbruggingsdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/LandschappelijkGebied> a skos:Concept ;
    skos:definition "Definitie ontbreekt in de BAG."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "landschappelijk gebied"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimte> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Lichtcel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Lichtcel waarmee het verlichtingsniveau naar een lager verlichtingsniveau omgeschakeld wordt (dimmen) wanneer de situatie dit toelaat."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "lichtcel"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeSensor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Lichtmast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Mast bestemd voor het dragen van een of meer verlichtingsarmaturen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "lichtmast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Lichtpunt> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een lichtpunt is een lamp die licht uitzendt niet verbonden met een mast die het maaiveld raakt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "lichtpunt"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Luifel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Afdak aangebracht aan de gevel van een pand, eventueel rustend op kolommen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "luifel"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeGebouwinstallatie> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/MaatschappelijkeOfPublieksvoorziening> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:altLabel "maatschappelijke en/of publieksvoorziening"@nl ;
    skos:definition "Bebouwd of landelijk gebied, niet zijnde woon- of bedrijventerrein, in gebruik voor maatschappelijke- en publieksdoeleinden (omvat overheids- en particuliere terreinen)."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "maatschappelijke of publieksvoorziening"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Muur> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een scheiding gemaakt van steen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "muur"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeScheiding> ;
    skos:scopeNote "Een stenen geluidswal wordt getypeerd als geluidsscherm."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/NatuurEnLandschap> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:definition "Gebied dat wegens natuurschoon en/of natuurlijke historie in stand wordt gehouden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "natuur en landschap"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/NummeraanduidingreeksPand> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "nummeraanduidingreeks"@nl ;
    skos:definition "Bevat de reeks nummeraanduidingen behorend bij het pand ten behoeve van visualisatie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "BuildingPart.nummeraanduidingreeks" ;
    skos:prefLabel "nummeraanduidingreeks pand"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Nummeraanduidingreeks>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Pand> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OeverOfSlootkant> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Inspire> ;
    skos:altLabel "oever, slootkant"@nl ;
    skos:definition "De strook land die in direct contact staat met water, inclusief het gebied tussen de hoogwaterlijn en laagwaterlijn."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "oever of slootkant"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeWaterdeel> ;
    skos:scopeNote "De kant insteek niet als aparte lijngeometrie opgenomen, maar is impliciet opgenomen als die kant van de vlakgeometrie die niet aan het naastliggende waterdeel grenst."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OpenLoods> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Niet verplaatsbaar licht gebouw met een open gevel, bestemd als berg- of werkplaats of als tijdelijk onderdak voor andere doeleinden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "open loods"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeOverigBouwwerk> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbaarToilet> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Voor mensen bedoeld toilet niet zijnde een pand, langs de openbare weg."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "openbaar toilet"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareVerlichtingskast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:altLabel "openbare verlichtingkast"@nl ;
    skos:definition "Kast ten behoeve van de regeling van de openbare verlichting."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "openbare verlichtingskast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeKast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Opslagtank> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Opslagfaciliteit voor vloeistoffen, gassen of energie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "opslagtank"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeOverigBouwwerk> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Overkapping> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een afzonderlijk staande overdekking rustend op kolommen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "overkapping"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeOverigBouwwerk> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Park> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:altLabel "recreatie: park"@nl ;
    skos:definition "Landschappelijk ingericht terrein, begroeid met houtachtige en kruidachtige vegetatie, verharding, objecten, waterpartijen en dergelijke, bedoeld als (grootschalige) recreatieve voorziening."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "park"@nl ;
