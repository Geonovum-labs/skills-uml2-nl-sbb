    skos:prefLabel "benzine- of olieput"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePut> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Benzinestation> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Geheel van installaties, verharding en opstallen waar brandstoffen ten behoeve van verbrandingsmotoren worden verkocht."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "benzinestation"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Berm> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een strook grond langs een weg of spoorweg."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "berm"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FunctieOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Betaalautomaat> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een apparaat dat betaalkaarten en/of contant geld accepteert om betalingen uit te voeren."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "betaalautomaat"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bewoning> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:definition "Gebied waarop panden of overige bouwwerken staan die voornamelijk gebruikt worden voor bewoning, inclusief erven en tuinen die bij de panden behoren."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bewoning"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bezinkbak> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een gesloten reservoir waarin het afvalwater tijdelijk wordt opgevangen met een slibreinigende voorziening."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bezinkbak"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeOverigBouwwerk> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bloembak> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO> ;
    skos:definition "Bak in de openbare ruimte met een permanent karakter, waarin planten of struiken zijn geplant."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bloembak"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeBak> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bolder> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/aquo> ;
    skos:definition "Een inrichting aan de wal, waar een schip, door middel van een tros of landvast, aan vastgelegd kan worden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bolder"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Boom> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een markante boom die geen onderdeel uitmaakt van een ander boom- of struikbeplanting."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "boom"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeVegetatieobject> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bordes> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Een verhard oppervlak, eventueel verhoogd en/of uitgevoerd met treden, grenzend aan een pand en primair bedoeld voor gebruik door voetgangers."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bordes"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeGebouwinstallatie> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bovenleidingmast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Mast die een onderdeel vormt van de bovenleidingdraagconstructie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bovenleidingmast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeMast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/BrandkraanOfBrandput> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:altLabel "brandkraan / -put"@nl ;
    skos:definition "Op de drinkwaterleiding aangesloten kraan, of deksel van een put voor het plaatsen van een brandkraan, op of nabij de openbare weg, voor brandbestrijding."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "brandkraan of brandput"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePut> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Brievenbus> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Uitpandige kast waar post in kan worden gedeponeerd ter bezorging."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "brievenbus"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeStraatmeubilair> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bungalowpark> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:altLabel "recreatie: bungalowpark"@nl ;
    skos:definition "Geheel van verharding, begroeiing, overige opstallen en gebouwen, bedoeld als vakantie-/weekendhuisjes die niet permanent bewoond worden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bungalowpark"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bunker> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Wikipedia> ;
    skos:definition "Een bunker is een van oorsprong militair verdedigingswerk dat een zekere mate van bescherming biedt tegen beschietingen en bombardementen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bunker"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeOverigBouwwerkPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Bushalte> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Halteplaats voor bussen van het openbaar vervoer."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "bushalte"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/CAIKast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Kast ten behoeve van de regeling van radio- en televisiesignalen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "CAI-kast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeKast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Camera> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Installatie voor de registratie van beelden van situaties, waarvan direkte observatie moeilijk of niet permanent mogelijk is."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "camera"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeSensor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Camping> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:altLabel "recreatie: camping"@nl ;
    skos:definition "Geheel van verharding, begroeiing en opstallen, in gebruik als terrein waar tijdelijk tenten en/of caravans kunnen worden geplaatst ten behoeve van recreatie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "camping"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Carpoolplaats> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Parkeerplaats die qua ligging en ontsluiting geschikt is voor carpooling."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "carpoolplaats"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeFunctioneelGebiedPlus> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Container> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Nagelvast met de grond verbonden inzamelmiddel voor afvalstoffen, doorgaans van metaal of kunststof waarin afvalstoffen worden verzameld, bewaard en waaruit deze afvalstoffen vervolgens worden overgeladen in een inzamelvoertuig."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "container"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeBak> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Damwand> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een grondkerende constructie die bestaat uit een verticaal in de grond geplaatste wand."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "damwand"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeScheiding> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Debietmeter> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/GWBR-gegevenswoordenboek-riolering> ;
    skos:definition "Een instrument dat de (afvoer)capaciteit van de volumestroom meet."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "debietmeter"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeSensor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Dek> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Direct door het verkeer belaste deel van de bovenbouw van de brug."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "dek"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Overbruggingsdeel> ;
    skos:scopeNote "Deel van een brug of viaduct dat boven de opleggingen op landhoofden en pijlers is gelegen."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Detectielus> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "In de verharding opgenomen lusvormig onderdeel van een verkeersdetector."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "detectielus"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeSensor> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Dijkpaal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/aquo> ;
    skos:definition "Een markant punt op de waterkering of op het strand dat dient als referentiepunt voor afstandsaanduidingen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "dijkpaal"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Draadraster> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Kunstmatige terreinafscheiding, niet zijnde een faunaraster, in de vorm van een overwegend houten, metalen of kunststoffen rechtopstaande palen met daartussen een of meerdere draden."@nl ;
