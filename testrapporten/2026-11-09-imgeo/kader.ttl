    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "grasland overig"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/GreppelOfDrogeSloot> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:altLabel "greppel, droge sloot"@nl ;
