    skos:altLabel "onverhard"@nl ;
    skos:definition "Wegdelen waar geen verharding of aaneengesloten vegetatie aanwezig is."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower <http://definities.geostandaarden.nl/imgeo/id/begrip/Boomschors>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeelPlusZand> ;
    skos:prefLabel "fysiek voorkomen ondersteunend wegdeel onverhard"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/OndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/GebakkenKlinkers> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:definition "Verharding gemaakt van straatbakstenen. Gebakken klinkers worden voornamelijk geproduceerd uit grondstof van eigen bodem – de beddingen van onze rivieren."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "gebakken klinkers"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Grasklinkers> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:definition "Elementenverharding bestaande uit elementen van beperkte afmetingen die ten behoeve van de doorgroei van grassen en kruiden, zijn voorzien van openingen of met tussenruimten aangebracht."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "grasklinkers"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Gravel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Wikipedia> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:definition "Gravel is een ondergrond van gemalen baksteen die veel wordt gebruikt bij tennis en ook wel op atletiekbanen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "gravel"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Grind> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:definition "Ongebonden verharding bestaande uit kiezelmateriaal, waarvan de stenen in doorsnede variëren van 1 tot 5 cm."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "grind"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Puin> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Wikipedia> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:definition "Puin is afvalmateriaal dat bestaat uit losse brokstukken, grotendeels bestaande uit stenen en beton, van gesloopte of ingestorte gebouwen, viaducten, bruggen en andere objecten."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "puin"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Schelpen> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/HalfVerhard> ;
    skos:definition "Ongebonden verharding bestaande uit schelpenmateriaal."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "schelpen"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Sierbestrating> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:definition "Bestrating, uitgevoerd in verschillende bestratingsverbanden en -materialen, of in een sierverband, die vooral wordt toegepast uit esthetische overwegingen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "sierbestrating"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Tegels> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:definition "Bestrating van tegels, een platte vaak vierkante betonnen steen; veelal gebruikt voor trottoirbestrating."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "tegels"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/TypeMast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-1> ;
    skos:altLabel "plus-type"@nl ;
