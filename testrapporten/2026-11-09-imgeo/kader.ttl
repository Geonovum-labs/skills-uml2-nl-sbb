<http://definities.geostandaarden.nl/imgeo/id/begrip/Heesters> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Groenvoorziening> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/Groenvoorziening> ;
    skos:definition "Beplanting van houtige gewassen die struikvormend zijn en die al dan niet een gesloten geheel vormen. Het accent ligt op de sierwaarde, de beplanting kan uit één soort of uit meerdere soorten bestaan. Onder de heesters kan een houtachtige of kruidachtige onderbegroeiing aanwezig zijn. Het oppervlak met struikachtige gewassen is meer dan 50% van de totale oppervlakte van het vak."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "heesters"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OnbegroeidTerreindeel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:definition "Kleinste functioneel onafhankelijk stukje van een terrein, dat er binnen het objecttype Terrein van NEN 3610 wordt onderscheiden, zonder aaneengesloten vegetatie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OnbegroeidTerreindeel" ;
    skos:prefLabel "onbegroeid terreindeel"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOnbegroeidTerreindeel>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOnbegroeidTerreindeelPlus>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/OnbegroeidTerreindeelOpTalud> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimteLabel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:definition "Naam en plaatsingspunten van een in de BAG geregistreerde OPENBARE RUIMTE."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OpenbareRuimteLabel" ;
    skos:prefLabel "openbare ruimte label"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/IdentificatieBAGOPR>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimteNaam>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimteType> ;
    skos:scopeNote "Dit objecttype wordt in de BGT geregistreerd ten behoeve van visualisatie-doeleinden. In het optionele IMGeo deel is het mogelijk ook de vlakgeometrie van de openbare ruimte op te nemen."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Paal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Inrichtingselement> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/Inrichtingselement> ;
    skos:definition "Langwerpig stuk hout, ijzer, steen enz., dat in de grond staat."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Paal" ;
    skos:prefLabel "paal"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Hectometeraanduiding>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/NietBgt>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> ;
    skos:scopeNote "Er kunnen meerdere borden/sensoren aan een paal bevestigd zijn. Dit is niet expliciet gemodelleerd."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Planten> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Groenvoorziening> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/Groenvoorziening> ;
    skos:definition "Beheerde niet nader gespecificeerde beplanting van groenvak in de openbare ruimte."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "planten"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/RijbaanAutosnelweg> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    isothes:narrowerGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Calamiteitendoorsteek>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Verbindingsweg> ;
    skos:definition "Wegdeel dat onderdeel is van een weg uitsluitend bestemd voor snelverkeer en met gescheiden rijbanen en ongelijkvloerse kruisingen, daartoe aangeduid met het betreffende verkeersbord."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower <http://definities.geostandaarden.nl/imgeo/id/begrip/Calamiteitendoorsteek>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Verbindingsweg> ;
    skos:prefLabel "rijbaan autosnelweg"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/RijbaanAutoweg> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    isothes:narrowerGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Calamiteitendoorsteek>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Verbindingsweg> ;
    skos:definition "Wegdeel dat onderdeel is van een weg uitsluitend bestemd voor snelverkeer, daartoe aangeduid met het betreffende verkeersbord."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower <http://definities.geostandaarden.nl/imgeo/id/begrip/Calamiteitendoorsteek>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Verbindingsweg> ;
    skos:prefLabel "rijbaan autoweg"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/RijbaanRegionaleWeg> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    isothes:narrowerGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Verbindingsweg>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Verkeersdrempel> ;
    skos:definition "Wegdeel dat onderdeel is van een weg die een verbinding vormt tussen bewoonde oorden of tussen wijken binnen een dorp of stad."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower <http://definities.geostandaarden.nl/imgeo/id/begrip/Verbindingsweg>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/Verkeersdrempel> ;
    skos:prefLabel "rijbaan regionale weg"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Struikrozen> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Groenvoorziening> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/Groenvoorziening> ;
    skos:definition "Beheerde beplanting van groenvak in de openbare ruimte, zijnde in struikvorm groeiende rozen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "struikrozen"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Verkeersdrempel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-2660> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/RijbaanLokaleWeg>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/RijbaanRegionaleWeg> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/RijbaanLokaleWeg>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/RijbaanRegionaleWeg> ;
    skos:definition "Verhoging in een regionale rijbaan, bedoeld om het gemotoriseerde verkeer met een lage snelheid te laten rijden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "verkeersdrempel"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Watervlakte> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    isothes:narrowerGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Haven>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/MeerOfPlasVenOfVijver> ;
    skos:definition "Alle oppervlakken die vrij permanent met zoet water zijn bedekt. (zoals meer, plas, ven, vijver)."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:narrower <http://definities.geostandaarden.nl/imgeo/id/begrip/Haven>,
        <http://definities.geostandaarden.nl/imgeo/id/begrip/MeerOfPlasVenOfVijver> ;
    skos:prefLabel "watervlakte"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Wegdeel> a skos:Concept ;
