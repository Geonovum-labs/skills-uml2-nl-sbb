    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/GeslotenVerharding> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/GeslotenVerharding> ;
    skos:definition "Gesloten verharding bestaande uit gewapend of ongewapend beton."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "cementbeton"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeelOnverhard> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    isothes:narrowerGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/Boomschors>,
