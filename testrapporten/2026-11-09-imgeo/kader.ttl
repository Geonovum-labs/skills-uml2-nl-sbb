    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "asfalt"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Betonelement> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-1> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:altLabel "beton element"@nl ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:definition "Geprepareerde elementen van beton zoals, trottoirbanden, opsluitbanden en stelconplaten."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "betonelement"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Betonstraatstenen> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenVerharding> ;
    skos:definition "Verharding gemaakt van betonstraatstenen. Straatsteen die als goedkope vervanging van de gebakken klinkers is ontwikkeld."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "betonstraatstenen"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Cementbeton> a skos:Concept ;
