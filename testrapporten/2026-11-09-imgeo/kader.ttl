    skos:definition "Kast ten behoeve van het meten van permanente verkeertellingen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "telkast"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeKast> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Telpaal> a skos:Concept ;
