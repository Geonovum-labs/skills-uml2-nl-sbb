<http://definities.geostandaarden.nl/imgeo/id/begrip/OndersteunendWegdeelOpTalud> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "ondersteunendWegdeelOpTalud"@nl ;
    skos:definition "Indicatie of het object wel of niet op een hellend vlak ligt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "AuxiliaryTrafficArea.ondersteunendWegdeelOpTalud" ;
