    isothes:broaderGeneric <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:broader <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:definition "Kleinste functioneel onafhankelijk stukje van een NEN 3610 Weg met gelijkblijvende, homogene eigenschappen en relaties en primair bedoeld voor gebruik door weg-, spoor- en vliegverkeer te land."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "TrafficArea" ;
