    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "rietland"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Rooster> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Een rooster niet zijnde lijnafwatering of wildrooster."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "rooster"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Ruiterpad> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een wegdeel primair aangelegd voor het gebruik door ruiters."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "ruiterpad"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Sluis> a skos:Concept ;
