<http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimteNaam> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BAG> ;
    skos:altLabel "openbareRuimteNaam"@nl ;
    skos:definition "Een door het bevoegde gemeentelijke orgaan aan een OPENBARE RUIMTE toegekende benaming."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OpenbareRuimteLabel.openbareRuimteNaam" ;
    skos:prefLabel "openbare ruimte naam"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimteLabel> ;
    skos:scopeNote "Bij dit attribuut is aangegeven dat zowel materiële als formele historie worden bijgehouden. De openbare ruimtenaam is opgenomen in het BGT informatiemodel ten behoeve van visualisatie maar wordt overgenomen uit de BAG."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimteType> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BAG> ;
    skos:altLabel "openbareRuimteType"@nl ;
    skos:definition "De aard van de als zodanig benoemde OPENBARE RUIMTE."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OpenbareRuimteLabel.openbareRuimteType" ;
    skos:prefLabel "openbare ruimte type"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/OpenbareRuimteLabel> ;
    skos:scopeNote "Bij dit attribuut is aangegeven dat zowel materiële als formele historie worden bijgehouden. De openbare ruimtenaam is opgenomen in het BGT informatiemodel ten behoeve van visualisatie maar wordt overgenomen uit de BAG."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Overkluizing> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Wikipedia> ;
    skos:definition "Een overkluizing is een civieltechnisch kunstwerk waarmee een weg een andere weg, een plein of een waterloop (kruiselings) overwelft. In het geval van een waterweg is er onder het bouwwerk (vaak) geen scheepvaart mogelijk, maar ligt het wateroppervlak nog wel vrij. Een overkluizing is te vergelijken met een brug, alleen bestaat de brug in dit geval vaak niet uit een wegdek maar uit een opstal. Anders gesteld: het maakt meestal geen deel uit van een weg."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "overkluizing"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Overweg> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Een gelijkvloerse kruising van een wegdeel en een wegdeel type ov-baan met spoor type trein of sneltram."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "overweg"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Panoramabeelden> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "De geometrie is vanaf panoramafoto's ingewonnen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "panoramabeelden"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Parkeervlak> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Wegdeel bestemd voor het parkeren van motorvoertuigen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "parkeervlak"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Perron> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Verhoogde constructie langs een spoorrail of tramrail voor het in- en uitstappen van passagiers of voor het laden en lossen van goederen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "perron"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Plaatsingspunt> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Coördinaten voor de locatie waar het label moet worden getoond."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Labelpositie.plaatsingspunt" ;
    skos:prefLabel "plaatsingspunt"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Labelpositie> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Plan> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:definition "Situatie die ontstaat op het moment van verlening van een beschikking voor bouw of aanleg en duurt tot het moment waarop het object gereed is voor het beoogde gebruik."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "plan"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Ponton> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/aquo> ;
    skos:definition "Drijvende, dichte bak, waarover soms een dek is gelegd."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "ponton"@nl ;
    skos:scopeNote "Wordt onder andere gebruikt als aanlegplaats in havens en rivieren, of als ondersteuning van noodbruggen."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/PositieLabel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "positie"@nl ;
    skos:definition "Labelpositie, samengesteld uit plaatsingspunt en rotatiehoek."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Label.positie" ;
    skos:prefLabel "positie label"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Label> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/RelatieveHoogteligging> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:altLabel "relatieveHoogteligging"@nl ;
