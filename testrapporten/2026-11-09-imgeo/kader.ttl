    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "greppel of droge sloot"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Hectometeraanduiding> a skos:Concept ;
