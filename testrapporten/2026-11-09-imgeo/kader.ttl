    skos:prefLabel "gemengd bos"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/GraslandAgrarisch> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
