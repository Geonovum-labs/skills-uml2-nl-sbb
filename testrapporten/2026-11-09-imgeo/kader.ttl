    skos:notation "Paal.hectometeraanduiding" ;
    skos:prefLabel "hectometeraanduiding"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Paal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Heide> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Terreindeel overwegend begroeid met heide en heideachtige vegetaties."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "heide"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/HoekLabelpositie> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "hoek"@nl ;
