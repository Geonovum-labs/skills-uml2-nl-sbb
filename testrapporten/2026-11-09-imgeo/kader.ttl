    skos:prefLabel "relatieve hoogteligging"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Remmingswerk> a skos:Concept ;
