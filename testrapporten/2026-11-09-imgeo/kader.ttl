    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "PlantCover.plus-fysiekVookomen" ;
    skos:prefLabel "fysiek voorkomen begroeid terreindeel"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/BegroeidTerreindeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOnbegroeidTerreindeel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "bgt-fysiekVoorkomen"@nl ;
    skos:definition "Classificatie van het soort terrein, ingedeeld naar de uiterlijke verschijningsvorm."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OnbegroeidTerreindeel.bgt-fysiekVoorkomen" ;
    skos:prefLabel "fysiek voorkomen onbegroeid terreindeel"@nl ;
