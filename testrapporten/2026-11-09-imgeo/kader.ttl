<http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenOnbegroeidTerreindeelPlus> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-1> ;
    skos:altLabel "plus-fysiekVoorkomen"@nl ;
    skos:definition "Nadere classificatie van het soort terrein, ingedeeld naar de uiterlijke verschijningsvorm."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "OnbegroeidTerreindeel.plus-fysiekVoorkomen" ;
    skos:prefLabel "fysiek voorkomen onbegroeid terreindeel (plus)"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/OnbegroeidTerreindeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/FysiekVoorkomenWegdeel> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-1-0> ;
    skos:altLabel "plus-fysiekVoorkomenWegdeel"@nl ;
    skos:definition "Mate waarin het wegdeel al of niet verhard is, nadere classificatie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "TrafficArea.plus-fysiekVoorkomenWegdeel" ;
    skos:prefLabel "fysiek voorkomen wegdeel"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Wegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/GeenWaarde> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-3610-2011> ;
    skos:altLabel "geenWaarde"@nl ;
    skos:definition "Element heeft in werkelijkheid geen waarde."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "geen waarde"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Geleideconstructie> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Bermbeveiligingsconstructie bedoeld voor fysieke geleiding van voertuigen die uit de koers zijn geraakt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "geleideconstructie"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Geleidewerk> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/aquo> ;
    skos:definition "Fuikvormige constructie aansluitend aan het hoofd van een kunstwerk voor het geven van mechanische en visuele geleiding tijdens het invaren van dat kunstwerk."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "geleidewerk"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Gemaal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
