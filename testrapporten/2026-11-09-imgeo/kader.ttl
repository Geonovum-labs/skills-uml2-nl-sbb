    skos:prefLabel "verkeersbord"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypeBord> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Verkeersbordpaal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Paal waaraan een of meerdere verkeersborden zijn bevestigd."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "verkeersbordpaal"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/TypePaal> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Verkeerseiland> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Ondersteunend wegdeel van beperkte omvang, uitgevoerd als verhoging of wegmarkering, dat wordt omsloten door wegdelen en ten doel heeft verkeersstromen te scheiden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "verkeerseiland"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FunctieOndersteunendWegdeel> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Verkeersregelinstallatiekast> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Kast ten behoeve van de regeling van het verkeer."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "verkeersregelinstallatiekast"@nl ;
