    skos:prefLabel "gemaal"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/GemengdBos> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
