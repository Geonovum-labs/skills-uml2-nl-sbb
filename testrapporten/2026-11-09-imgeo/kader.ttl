<http://definities.geostandaarden.nl/imgeo/id/begrip/IdentificatieBAGVBOLaagsteHuisnummer> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "identificatieBAGVBOLaagsteHuisnummer"@nl ;
    skos:definition "Identificatie in de BAG registratie van het verblijfsobject met het laagste huisnummer behorende tot de reeks."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Nummeraanduidingreeks.identificatieBAGVBOLaagsteHuisnummer" ;
    skos:prefLabel "identificatie BAGVBO laagste huisnummer"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Nummeraanduidingreeks> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/InOnderzoek> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Stelselcatalogus> ;
    skos:altLabel "inOnderzoek"@nl ;
    skos:definition "Een aanduiding waarmee wordt aangegeven dat een onderzoek wordt uitgevoerd naar de juistheid van een of meer gegevens van het betreffende object."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "_CityObject.inOnderzoek" ;
    skos:prefLabel "in onderzoek"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Inrit> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Toegangswegen, oprijlanen en dergelijke met verkeersfunctie die leiden naar erven en terreinen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "inrit"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/InwinnendeInstantie> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "inwinnendeInstantie"@nl ;
    skos:definition "De organisatie die namens de bronhouder het object inwint."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Plaatsbepalingspunt.inwinnendeInstantie" ;
    skos:prefLabel "inwinnende instantie"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Plaatsbepalingspunt> ;
    skos:scopeNote "De inwinnende instantie kan de bronhouder zelf zijn of een organisatie aan wie dit is gedelegeerd. De Codelist is dezelfde lijst als die van de bronhouder van het BGTObject, maar dan uitgebreid met de inwinnende instanties. Indien de inwinnende instantie voor haar uitvoerende taak gebruik maakt van externe organisaties (zoals landmeetkundige bureaus) dan worden deze laatsten NIET aan de CodeList toegevoegd maar vullen zij de inwinnende instantie in voor wie zij het werk uitvoeren."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Inwinningsmethode> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "De wijze waarop het punt is ingewonnen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Plaatsbepalingspunt.inwinningsmethode" ;
    skos:prefLabel "inwinningsmethode"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Plaatsbepalingspunt> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Keermuur> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/Wikipedia> ;
    skos:definition "Een keermuur of keerwand is een stijf, grond- of waterkerend kunstwerk dat door een groot gewicht en een brede voet een grote standzekerheid kan bereiken. Een keermuur is meestal van gewapend beton, maar er kan ook ander materiaal gebruikt worden."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "keermuur"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Kwelder> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/aquo> ;
    skos:definition "Buitendijks gelegen aangeslibd land van een wad, dat bij gewone vloed niet meer onder loopt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "kwelder"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/LVPublicatiedatum> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Tijdstip waarop deze instantie van het object is opgenomen in de landelijke voorziening."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "_CityObject.LV-publicatiedatum" ;
    skos:prefLabel "LV-publicatiedatum"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/IMGeoObject> ;
    skos:scopeNote "Het gegeven is optioneel omdat een nieuw object pas een LV-publicatiedatum krijgt als het voor de eerste keer wordt opgenomen in de landelijke voorziening. Voor en tijdens aanlevering van een nieuw object aan de landelijke voorziening ontbreekt dit gegeven nog."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Laser> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "De geometrie is met behulp van een laserscanner ingewonnen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "laser"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Lijnafwatering> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:definition "Goot in de lengterichting van de verharding, niet zijnde molgoot. Bijvoorbeeld roostergoot en verholen goot."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "lijnafwatering"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/LokaalID> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-3610-2011> ;
    skos:altLabel "lokaalID"@nl ;
    skos:definition "Unieke identificatiecode binnen een registratie."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "NEN3610ID.lokaalID" ;
    skos:prefLabel "lokaal ID"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/NEN3610Id> ;
    skos:scopeNote "LokaalID is de identificatiecode die een object heeft binnen een (lokaal) registratie. De volgende karakters mogen in een lokaalID voorkomen: {”A” …”Z”, “a”…”z”,”0”…”9”, “_”, “-“, “,”,”.”} Dit is de IMGeo identificatie. Een betekenisloos nummer."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Meerpaal> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/aquo> ;
    skos:definition "Paal voor een kade of in een haven waaraan een schip kan worden afgemeerd."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "meerpaal"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Moeras> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Terreindeel met moerasvegetatie in stilstaand water van geringe diepte zonder merkbare toe- of afvloeiing."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "moeras"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Molgoot> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/CROW> ;
    skos:definition "Smalle goot (lijngeometrie) in de lengterichting van de verharding, met veelal een cirkelsegment als dwarsprofiel."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "molgoot"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Naaldbos> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Terreindeel begroeid met een dusdanige aantal naaldbomen dat deze een min of meer gesloten geheel vormen of, na volgroeiing van de bomen, zullen vormen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "naaldbos"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/NaamFunctioneelGebied> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:altLabel "naam"@nl ;
    skos:definition "De benaming van het functionele gebied."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "FunctioneelGebied.naam" ;
    skos:prefLabel "naam functioneel gebied"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/FunctioneelGebied> ;
    skos:scopeNote "Het datatype is GenericName. Naast het opnemen van de naam als CharacterString kan optioneel de codespace waarbinnen de naam is gedefinieerd worden opgenomen."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/NaamRegistratiefGebied> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/IMGEO-2-0> ;
    skos:altLabel "naam"@nl ;
    skos:definition "De benaming van het registratieve gebied."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "RegistratiefGebied.naam" ;
    skos:prefLabel "naam registratief gebied"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/RegistratiefGebied> ;
    skos:scopeNote "Het datatype is GenericName. Naast het opnemen van de naam als CharacterString kan optioneel de codespace waarbinnen de naam is gedefinieerd worden opgenomen."@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Namespace> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-3610-2011> ;
    skos:definition "Unieke verwijzing naar een registratie van objecten."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "NEN3610ID.namespace" ;
    skos:prefLabel "namespace"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/NEN3610Id> ;
    skos:scopeNote "Het attribuut ‘namespace’ is een unieke verwijzing naar de registratie die de identificatie uitdeelt. Deze lijst van registraties wordt beheerd door de beheerder van NEN3610. Binnen Nederland zal deze namespace vrijwel altijd met ‘NL.’ beginnen. De volgende karakters mogen in een namespace aanduiding voorkomen: {”A” …”Z”, “a”…”z”,”0”…”9”, “_”, “-“, “,”,”.”}"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/Nauwkeurigheid> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Gerealiseerde geometrische nauwkeurigheid van de geometrie van het object ten opzichte van de werkelijkheid, uitgedrukt in centimeters."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:notation "Plaatsbepalingspunt.nauwkeurigheid" ;
    skos:prefLabel "nauwkeurigheid"@nl ;
    skos:related <http://definities.geostandaarden.nl/imgeo/id/begrip/Plaatsbepalingspunt> .

<http://definities.geostandaarden.nl/imgeo/id/begrip/NietGeautoriseerd> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-3610-2011> ;
    skos:altLabel "nietGeautoriseerd"@nl ;
    skos:definition "Deze zender vindt dat de ontvanger niet geautoriseerd is om de waarde te kennen."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "niet geautoriseerd"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/NietOndersteund> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/NEN-3610-2011> ;
    skos:altLabel "nietOndersteund"@nl ;
    skos:definition "Zender houdt in zijn registratie geen waarde voor dit attribuut bij. Geldt voor alle objecten van dit objecttype."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "niet ondersteund"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OVBaan> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:definition "Wegdeel dat uitsluitend is bestemd en gemarkeerd voor openbaar vervoer en afgescheiden is van de andere wegdelen niet uitsluitend door markering."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
    skos:prefLabel "OV-baan"@nl .

<http://definities.geostandaarden.nl/imgeo/id/begrip/OnbegroeidTerreindeelOpTalud> a skos:Concept ;
    dct:source <http://definities.geostandaarden.nl/imgeo/id/bron/BGT> ;
    skos:altLabel "onbegroeidTerreindeelOpTalud"@nl ;
    skos:definition "Indicatie of het object wel of niet op een hellend vlak ligt."@nl ;
    skos:inScheme <http://definities.geostandaarden.nl/imgeo> ;
